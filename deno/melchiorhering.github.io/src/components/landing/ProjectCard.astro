---
// src/components/landing/ProjectCard.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/utils";

export interface Props {
  as?: string | any;
  class?: string;
  href?: string;
  heading?: string;
  subheading?: string;
  imagePath?: string;
  altText?: string;
  isOnlineImage?: boolean;
}

const {
  as: Tag = "a",
  class: className,
  href,
  heading,
  subheading,
  imagePath,
  altText = "",
  isOnlineImage = false,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif,webp,svg}",
);

// Safely map the local image function if the path exists and is local
const imageFn = imagePath && !isOnlineImage ? images[imagePath] : undefined;

if (imagePath && !isOnlineImage && !imageFn) {
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,webp,svg}"`,
  );
}
---

<Tag
  class={cn(
    className,
    "flex flex-col gap-y-3 rounded-2xl border border-border bg-primary-foreground md:w-1/3",
    href && "transition-all hover:border-foreground/25 hover:shadow-lg",
  )}
  href={href}
>
  {
    imagePath && (
      <div class="flex h-1/2 w-full justify-center rounded-2xl rounded-bl-none rounded-br-none bg-white">
        {isOnlineImage ? (
          <img
            src={imagePath}
            alt={altText}
            class="rounded-2xl object-scale-down p-4"
            loading="lazy"
          />
        ) : imageFn ? (
          <Image
            src={imageFn()}
            alt={altText}
            class="rounded-2xl object-scale-down p-4"
            loading="lazy"
          />
        ) : null}
      </div>
    )
  }

  <div class="flex h-1/2 flex-col gap-y-0.5 px-5 py-2">
    {heading && <h1 class="text-lg font-medium">{heading}</h1>}
    {subheading && <h2 class="text-muted-foreground">{subheading}</h2>}
  </div>

  <slot />
</Tag>
