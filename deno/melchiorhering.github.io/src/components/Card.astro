---
// src/components/Card.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/utils";

const {
  as: Tag = "div",
  class: className,
  href,
  heading,
  subheading,
  date,
  imagePath,
  altText,
  imageClass,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif,webp,svg}",
);

// 1. Treat HTTP and absolute public folder paths (e.g., /images/...) as external/public
const isExternalImage =
  imagePath?.startsWith("http") ||
  (imagePath?.startsWith("/") && !imagePath?.startsWith("/src/"));

// 2. If it's a local image, intelligently format the path so the glob can find it
let globPath = imagePath;
if (imagePath && !isExternalImage) {
  // If only the filename was passed, automatically prepend the assets directory
  if (!imagePath.startsWith("/src/assets/")) {
    globPath = `/src/assets/${imagePath}`;
  }

  if (!images[globPath!]) {
    throw new Error(
      `"${globPath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,webp,svg}"`,
    );
  }
}
---

<Tag
  class={cn(
    "relative rounded-2xl border border-border bg-primary-foreground px-5 py-3",
    href && "transition-all hover:border-foreground/25 hover:shadow-md",
    className,
  )}
  href={href}
>
  {
    /* 3. Render a standard <img> for external/public URLs, and Astro <Image> for local files */
  }
  {
    imagePath && isExternalImage ? (
      <img
        src={imagePath}
        alt={altText}
        class={cn("absolute mb-3", imageClass)}
        loading="lazy"
      />
    ) : globPath && images[globPath] ? (
      <Image
        src={images[globPath]()}
        alt={altText}
        class={cn("absolute mb-3", imageClass)}
        loading="lazy"
      />
    ) : null
  }
  <div class="flex h-full flex-1 flex-col gap-y-1.5">
    <div class="flex flex-col gap-y-0.5">
      <h1 class="text-lg font-medium">{heading}</h1>
      <h2 class="text-muted-foreground">{subheading}</h2>
      <h2 class="text-muted-foreground">{date}</h2>
    </div>

    <slot />
  </div>
</Tag>
