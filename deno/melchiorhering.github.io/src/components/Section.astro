---
import { cn } from "@/utils";

const { class: className, title, id } = Astro.props;

// Automatically generate an ID from the title (e.g., "Blog Posts" -> "blog-posts")
const sectionId = id || title?.toLowerCase().replace(/\s+/g, "-");
---

<section
  id={sectionId}
  class={cn(className, "flex flex-col py-4  gap-y-5 md:flex-row md:gap-y-2")}
>
  <div class="text-2xl font-semibold md:w-1/6">
    <h2
      class="bg-linear-to-r from-sky-600 to-sky-400 bg-clip-text text-transparent dark:from-sky-400 dark:to-sky-200"
    >
      {title}
    </h2>
  </div>
  <div class="flex flex-col gap-y-3 md:w-4/6">
    <slot />
  </div>
</section>
