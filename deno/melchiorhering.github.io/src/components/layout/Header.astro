---
import { menuLinks } from "@/site-config";
const webpageLogo = "favicon.svg";
---

<header
  class="relative mx-auto flex w-full flex-wrap items-center justify-between py-6 sm:flex-nowrap sm:px-6 md:py-8"
>
  {/* Top Bar: Logo + Mobile Controls */}
  <div class="flex w-full items-center justify-between sm:w-auto">
    <a
      class="flex items-center gap-x-2 text-xl font-semibold md:gap-x-4 md:text-2xl"
      href="/"
      aria-label="Brand"
    >
      <img
        src={webpageLogo}
        alt="Webpage logo"
        class="flex h-12 w-auto items-center justify-center md:h-28"
      />
      <span class="font-satoshi flex text-xl md:text-3xl"> Information </span>
    </a>

    {/* Mobile Controls (Visible only on small screens) */}
    <div class="flex items-center gap-2 sm:hidden">
      <button
        class="theme-toggle relative rounded-md border border-gray-300 dark:border-gray-700 p-1.5 text-orange-500 dark:text-sky-400 transition-all hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="Toggle Dark Mode"
      >
        <span class="sr-only">Dark Theme</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:hidden dark:-rotate-90 dark:scale-0"
          ><path
            fill="currentColor"
            d="M12 15q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15m0 1q-1.671 0-2.836-1.164T8 12q0-1.671 1.164-2.836T12 8q1.671 0 2.836 1.164T16 12q0 1.671-1.164 2.836T12 16m-7-3.5H1.5v-1H5zm17.5 0H19v-1h3.5zM11.5 5V1.5h1V5zm0 17.5V19h1v3.5zM6.746 7.404l-2.16-2.098l.695-.744l2.111 2.134zM18.72 19.438l-2.117-2.14l.652-.702l2.16 2.098zM16.596 6.746l2.098-2.16l.744.695l-2.134 2.111zM4.562 18.72l2.14-2.117l.663.652l-2.078 2.179zM12 12"
          ></path></svg
        >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="hidden h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:block dark:rotate-0 dark:scale-100"
          ><path
            fill="currentColor"
            d="M12.058 20q-3.334 0-5.667-2.333Q4.058 15.333 4.058 12q0-3.038 1.98-5.27Q8.02 4.5 10.942 4.097q.081 0 .159.006t.153.017q-.506.706-.801 1.57q-.295.865-.295 1.811q0 2.667 1.866 4.533q1.867 1.867 4.534 1.867q.952 0 1.813-.295q.862-.295 1.548-.801q.012.075.018.153q.005.078.005.158q-.384 2.923-2.615 4.904T12.057 20"
          ></path></svg
        >
      </button>

      <button
        id="mobileMenuBtn"
        class="rounded-md border border-gray-300 dark:border-gray-700 p-1.5 text-foreground transition-all hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* Navigation Links - Absolute positioned on mobile to overlap content */}
  <nav
    id="nav-menu"
    class="absolute left-0 top-full z-50 flex w-full flex-col items-center gap-4 gap-x-6 bg-background/95 px-4 py-6 shadow-lg backdrop-blur-md opacity-0 pointer-events-none -translate-y-4 transition-all duration-300 sm:static sm:w-auto sm:flex-row sm:bg-transparent sm:py-0 sm:shadow-none sm:backdrop-blur-none sm:opacity-100 sm:pointer-events-auto sm:translate-y-0"
    aria-label="global"
  >
    {
      menuLinks.map((link) => (
        <a
          href={link.path}
          class="nav-link text-[1.05rem] font-medium transition-colors duration-300 bg-linear-to-r from-sky-600 to-sky-400 dark:from-sky-400 dark:to-sky-200 bg-clip-text text-transparent sm:text-foreground hover:text-transparent"
          aria-label={`Nav Menu Item: ${link.title}`}
        >
          {link.title}
        </a>
      ))
    }

    {/* Desktop Theme Toggle */}
    <div class="hidden sm:flex sm:items-center">
      <button
        class="theme-toggle relative rounded-md border border-gray-300 dark:border-gray-700 p-1.5 text-orange-500 dark:text-sky-400 transition-all hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="Toggle Dark Mode"
      >
        <span class="sr-only">Dark Theme</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          class="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:hidden dark:-rotate-90 dark:scale-0"
          ><path
            fill="currentColor"
            d="M12 15q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15m0 1q-1.671 0-2.836-1.164T8 12q0-1.671 1.164-2.836T12 8q1.671 0 2.836 1.164T16 12q0 1.671-1.164 2.836T12 16m-7-3.5H1.5v-1H5zm17.5 0H19v-1h3.5zM11.5 5V1.5h1V5zm0 17.5V19h1v3.5zM6.746 7.404l-2.16-2.098l.695-.744l2.111 2.134zM18.72 19.438l-2.117-2.14l.652-.702l2.16 2.098zM16.596 6.746l2.098-2.16l.744.695l-2.134 2.111zM4.562 18.72l2.14-2.117l.663.652l-2.078 2.179zM12 12"
          ></path></svg
        >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          class="hidden h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:block dark:rotate-0 dark:scale-100"
          ><path
            fill="currentColor"
            d="M12.058 20q-3.334 0-5.667-2.333Q4.058 15.333 4.058 12q0-3.038 1.98-5.27Q8.02 4.5 10.942 4.097q.081 0 .159.006t.153.017q-.506.706-.801 1.57q-.295.865-.295 1.811q0 2.667 1.866 4.533q1.867 1.867 4.534 1.867q.952 0 1.813-.295q.862-.295 1.548-.801q.012.075.018.153q.005.078.005.158q-.384 2.923-2.615 4.904T12.057 20"
          ></path></svg
        >
      </button>
    </div>
  </nav>

  <script>
    const mobileMenuBtn = document.getElementById("mobileMenuBtn");
    const navMenu = document.getElementById("nav-menu");

    mobileMenuBtn?.addEventListener("click", () => {
      navMenu?.classList.toggle("opacity-0");
      navMenu?.classList.toggle("pointer-events-none");
      navMenu?.classList.toggle("-translate-y-4");
    });

    const navLinks = document.querySelectorAll(".nav-link");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 640) {
          navMenu?.classList.add("opacity-0");
          navMenu?.classList.add("pointer-events-none");
          navMenu?.classList.add("-translate-y-4");
        }
      });
    });

    function getCurrentTheme() {
      return localStorage.getItem("theme");
    }

    const themeToggleBtns = document.querySelectorAll(".theme-toggle");
    themeToggleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const toggleDarkModeEvent = new CustomEvent("theme-change", {
          detail: { theme: getCurrentTheme() === "light" ? "dark" : "light" },
        });
        document.dispatchEvent(toggleDarkModeEvent);
      });
    });
  </script>
</header>
